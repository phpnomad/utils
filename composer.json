{
    "name": "phpnomad/utils",
    "description": "",
    "type": "library",
    "homepage": "https://github.com/phpnomad/core",
    "readme": "README.md",
    "license": "MIT",
    "scripts": {
        "php-cs-fixer": "php-cs-fixer fix"
    },
    "autoload": {
        "psr-4": {
            "PHPNomad\\Utils\\": "lib/"
        },
        "classmap": [
            "lib/Exceptions/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPNomad\\Core\\Tests\\": "tests/",
            "PHPNomad\\Tests\\Unit\\": "tests/Unit/"
        }
    },
    "authors": [
        {
            "name": "Alex Standiford",
            "email": "alex@standiford.us"
        }
    ],
    "require-dev": {
        "doctrine/instantiator": "^1.5",
        "myclabs/deep-copy": ">=1.13.4 <1.14",
        "phpnomad/tests": "^0.1.0 || ^0.3.0",
        "phpunit/phpunit": "^9.6.33",
        "symfony/process": "^5.4.51"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
